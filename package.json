{
  "name": "vue-draggable-resizable",
  "version": "1.6.1",
  "private": false,
  "description": "[Vue3 Component] draggable and resizable component for Vue 3, support snapping and aligning.",
  "keywords": [
    "component",
    "draggable",
    "resizable",
    "vue"
  ],
  "homepage": "https://github.com/vBenTec/vue3-draggable-resizable",
  "bugs": {
    "url": "https://github.com/vBenTec/vue3-draggable-resizable/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vBenTec/vue3-draggable-resizable.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/vue-draggable-resizable.umd.js",
  "module": "./dist/vue-draggable-resizable.mjs",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vue-draggable-resizable.mjs",
      "require": "./dist/vue-draggable-resizable.umd.js"
    }
  },
  "scripts": {
    "dev-vue": "vite",
    "serve": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build": "vite build && tsc --emitDeclarationOnly",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.4",
    "@vitejs/plugin-vue": "^6.0.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "~5.8.3",
    "vite": "npm:rolldown-vite@latest",
    "vue": "^3.5.17"
  },
  "packageManager": "pnpm@10.12.3"
}
