{
  "name": "vue3-draggable-resizable",
  "version": "2.0.0-beta.0",
  "private": false,
  "description": "Draggable and resizable component for Vue 3, with snapping, alignment guides and full TypeScript support.",
  "keywords": [
    "component",
    "draggable",
    "resizable",
    "snapping",
    "vue",
    "vue3"
  ],
  "homepage": "https://github.com/vBenTec/vue3-draggable-resizable",
  "bugs": {
    "url": "https://github.com/vBenTec/vue3-draggable-resizable/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vBenTec/vue3-draggable-resizable.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev-vue": "vite",
    "serve": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build && rolldown -c rolldown.dts.config.ts",
    "check:pkg": "publint && attw --pack --profile esm-only --exclude-entrypoints style.css",
    "prepublishOnly": "pnpm build && pnpm check:pkg"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.0.4",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "publint": "^0.3.25",
    "rolldown": "^1.2.19",
    "rolldown-plugin-dts": "^0.30.2",
    "typescript": "~5.8.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.17",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.12.3"
}
